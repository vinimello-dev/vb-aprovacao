generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostFormat {
  VIDEO
  CAROUSEL
  STATIC
  REELS
  STORIES
}

enum PostStatus {
  PENDENTE
  AJUSTES
  APROVADO
}

model Client {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  pin         String   // PIN de 4 dígitos
  logoUrl     String?
  
  // Dados Cadastrais & CRM do Cliente
  phone       String?  // Telefone / WhatsApp de contato
  cnpj        String?  // CNPJ ou CPF
  email       String?  // E-mail comercial
  responsible String?  // Nome do Responsável / Decisor
  instagram   String?  // @ do perfil no Instagram
  notes       String?  @db.Text // Observações e preferências do cliente

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]
  demands     Demand[]
  cycles      ClientCycle[]
  scripts     RecordingScript[]
  documents   ClientDocument[]

  @@map("clients")
}

model Post {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  cycleId       String?
  cycle         ClientCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  title         String
  caption       String?     @db.Text // Legenda do post
  format        PostFormat  @default(STATIC)
  status          PostStatus  @default(PENDENTE)
  scheduledDate   DateTime?   // Data de agendamento/publicação no mês
  scheduledTime   String?     // Horário opcional de publicação (ex: "18:30")
  revisionVersion Int         @default(0) // 0 = original, 1+ = vídeo revisado versão X
  isVideoOnly     Boolean     @default(false) // true = vídeo avulso para aprovação (sem post/legenda)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  media         PostMedia[]
  comments      Comment[]

  @@map("posts")
}

model PostMedia {
  id           String   @id @default(cuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  url          String   @db.Text
  mediaType    String   // "VIDEO" ou "IMAGE"
  order        Int      @default(0)
  thumbnailUrl String?  @db.Text
  duration     Float?   // Duração em segundos (se vídeo)
  
  createdAt    DateTime @default(now())

  @@map("post_medias")
}

model Comment {
  id               String   @id @default(cuid())
  postId           String
  post             Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  author           String   @default("Cliente")
  authorRole       String   @default("CLIENT") // "CLIENT" ou "AGENCY"
  content          String   @db.Text
  
  timestampSeconds Float?   // Segundos do player de vídeo
  slideIndex       Int?     // Índice da lâmina do carrossel (0, 1, 2...)
  resolved         Boolean  @default(false)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("comments")
}

model DemandColumn {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demands   Demand[]

  @@map("demand_columns")
}

model Demand {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  columnId    String
  column      DemandColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  order       Int           @default(0)
  dueDate     DateTime?
  completed   Boolean       @default(false)
  priority    String        @default("NORMAL") // "BAIXA", "NORMAL", "ALTA", "URGENTE"

  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("demands")
}

// 1. Ciclos de Entrega / Meses de Planejamento (Imagem 1)
model ClientCycle {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String    // Ex: "Ciclo 11 - Novembro 2026", "Entrega Teste"
  month       Int?      // 1 a 12
  year        Int?      // Ex: 2026
  targetDate  DateTime? // Data específica do post ou da entrega
  active      Boolean   @default(true)
  
  posts       Post[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("client_cycles")
}

// 2. Roteiros de Gravação de Cada Captação (Imagem 2)
model RecordingScript {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  title         String    // Ex: "Captação 01 - Roteiro Reels Institucional"
  recordingDate DateTime? // Data agendada da captação
  hook          String?   @db.Text // Gancho / Primeiros 3 segundos
  content       String    @db.Text // Roteiro completo / Cenas / Falas
  status        String    @default("A_GRAVAR") // "A_GRAVAR", "GRAVADO", "EM_EDICAO", "FINALIZADO"
  scenesCount   Int?      @default(1)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("recording_scripts")
}

// 3. Documentos e Contratos do Cliente (Imagem 2)
model ClientDocument {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  title       String   // Ex: "Contrato Anual de Gestão 2026", "Manual de Marca"
  type        String   @default("CONTRATO") // "CONTRATO", "BRIEFING", "IDENTIDADE_VISUAL", "OUTRO"
  fileUrl     String   @db.Text // Link Google Drive, DocuSign, PDF
  notes       String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_documents")
}
